# ============================================================
# Plato's Ship — Phase 2. Copy to ../.env (Code_Phase_2/.env) and fill keys.
# run_all.py reads ../.env first, then a local ./.env override if present.
#
# DEFAULT ROUTING needs only DeepSeek + OpenRouter keys. The other providers
# are optional failovers (see ../API_AND_RECHARGE.md). Provider base URLs and
# key names are also declared in config/models.yaml `providers:`.
# ============================================================

# --- DeepSeek (focal + judge tier 3) — 2 keys, round-robin ---
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# NOTE: `deepseek-chat` alias retires 2026-07-24 -> use `deepseek-v4-flash`.

# --- OpenRouter (sweep focals, weak peers, gpt-4o-mini, judge T1/T2) — 2 keys ---
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# --- Mistral (optional; default routing uses OpenRouter for Small 3.2) ---
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# --- nano-gpt (optional failover) ---
NANOGPT_API_KEY_1=
NANOGPT_API_KEY_2=
NANOGPT_API_BASE_URL=https://nano-gpt.com/api/v1

# --- LinkAPI (optional failover; verify slugs/prices in-console first) ---
LINKAPI_API_KEY_1=
LINKAPI_API_KEY_2=
LINKAPI_API_BASE_URL=https://api.linkapi.ai/v1

# --- GCP Vertex (optional; native Gemini judge) ---
GCP_VERTEX_OPENAI_BASE_URL=
GCP_VERTEX_ACCESS_TOKEN=

# --- HuggingFace token (GPU_Only probe, gated repos) ---
HUGGINGFACE_TOKEN=

# --- Experiment ---
RANDOM_SEED=20260502

# Repo slug used by the GPU-probe helper scripts (owner/repo). Kept out of
# source so the released artefact carries no identifying URL.
GIT_REPO_SLUG=
