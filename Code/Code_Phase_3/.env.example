# Phase 3 — copy to .env and fill in. NEVER commit .env.
# Each key is a separate billing account; the pipeline rotates round-robin
# across the keys listed for a provider, so fund each account, not each
# provider. See Code_Phase_2/API_AND_RECHARGE.md for the cost model.

# ── DeepSeek (primary focal) ──────────────────────────────────────────────
# The `deepseek-chat` alias retired 2026-07-24; config/models.yaml pins
# `deepseek-v4-flash` and the runner aborts if the provider serves anything else.
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# ── OpenRouter (six sweep focals, weak peers, judge tier 1, verifier) ─────
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# ── LinkAPI (gpt-4o-mini; ~10x cheaper than OpenRouter) ───────────────────
# No fallback chain is allowed for focal calls: a fallback is what served 75
# Phase-2 "gpt-4o-mini" trials from gpt-4.1-mini.
AZUREOPENAI_LINKAPI_KEY=
LINKAPI_API_BASE_URL=https://api.linkapi.ai/v1

# ── Mistral (judge tier 2) ────────────────────────────────────────────────
MISTRAL_API_KEY_1=
Mistral_API_Key_2=
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# ── nano-gpt (peer/judge failover only, never focal) ──────────────────────
Nano_GPT_API_KEY=
Nano_GPT_Base_URL=https://nano-gpt.com/api/v1

# ── Hugging Face (X4: GSM-Symbolic download) ──────────────────────────────
HUGGINGFACE_TOKEN=
